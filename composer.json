{
    "name": "silvershop-suite/address-lookup-pro6pp",
    "description": "Pro6PP address provider for silvershop-suite/address-lookup (CMS 6): a satellite connector that resolves NL addresses structurally (postcode + house number -> street + settlement + municipality + province + lat/lng) via the Pro6PP v2 autocomplete API, and validates/canonicalises BE/DE/FR/LU (+ AT/CH/DK) addresses. Registers the `pro6pp` provider and fills the base module's FR + LU gaps. Paid per-call; key as SS_PRO6PP_API_KEY.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "silvershop", "address", "autocomplete", "postcode", "checkout", "pro6pp", "validation"],
    "authors": [
        {
            "name": "RVXD"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silvershop/core": "^6",
        "silvershop-suite/address-lookup": "^1"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\AddressLookup\\Pro6pp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\AddressLookup\\Pro6pp\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "expose": [],
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
